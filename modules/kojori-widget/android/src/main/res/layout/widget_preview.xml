<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_surface"
  android:orientation="vertical"
  android:padding="14dp">

  <!-- Compact direction switch -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/widget_chip_idle"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="2dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_direction_active_380"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingHorizontal="8dp">

      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="3dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_direction_arrow" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kojori"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <ImageView
      android:layout_width="30dp"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:importantForAccessibility="no"
      android:padding="7dp"
      android:src="@drawable/widget_ic_swap" />
  </LinearLayout>

  <!-- Header row -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:paddingVertical="4dp"
      android:paddingHorizontal="2dp"
      android:text="from Sulkhan-Saba [#853]"
      android:textColor="@color/widget_text_dim"
      android:textSize="11sp"
      android:letterSpacing="0.02" />

    <ImageView
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:background="@color/widget_border"
      android:importantForAccessibility="no" />
  </LinearLayout>

  <include layout="@layout/widget_list_day_header" />

  <include layout="@layout/widget_list_featured" />

  <!-- Sample departure 2 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="2dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="44dp"
      android:background="@drawable/widget_bus_chip"
      android:gravity="center"
      android:paddingHorizontal="8dp"
      android:paddingVertical="5dp"
      android:text="316"
      android:textColor="@color/widget_teal"
      android:textSize="13sp"
      android:textStyle="bold"
      android:fontFamily="monospace" />

    <TextView
      android:layout_marginStart="10dp"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="end"
      android:text="09:45"
      android:textColor="@color/widget_text"
      android:textSize="18sp"
      android:textStyle="bold"
      android:fontFamily="monospace"
      android:letterSpacing="0.04" />
  </LinearLayout>

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginStart="54dp"
    android:background="@color/widget_border"
    android:importantForAccessibility="no" />

  <!-- Sample departure 3 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="2dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="44dp"
      android:background="@drawable/widget_bus_chip"
      android:gravity="center"
      android:paddingHorizontal="8dp"
      android:paddingVertical="5dp"
      android:text="380"
      android:textColor="@color/widget_amber"
      android:textSize="13sp"
      android:textStyle="bold"
      android:fontFamily="monospace" />

    <TextView
      android:layout_marginStart="10dp"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="end"
      android:text="10:15"
      android:textColor="@color/widget_text"
      android:textSize="18sp"
      android:textStyle="bold"
      android:fontFamily="monospace"
      android:letterSpacing="0.04" />
  </LinearLayout>

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginStart="54dp"
    android:background="@color/widget_border"
    android:importantForAccessibility="no" />

  <!-- Sample departure 4 -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:paddingHorizontal="2dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="44dp"
      android:background="@drawable/widget_bus_chip"
      android:gravity="center"
      android:paddingHorizontal="8dp"
      android:paddingVertical="5dp"
      android:text="316"
      android:textColor="@color/widget_teal"
      android:textSize="13sp"
      android:textStyle="bold"
      android:fontFamily="monospace" />

    <TextView
      android:layout_marginStart="10dp"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="end"
      android:text="10:30"
      android:textColor="@color/widget_text"
      android:textSize="18sp"
      android:textStyle="bold"
      android:fontFamily="monospace"
      android:letterSpacing="0.04" />
  </LinearLayout>

</LinearLayout>
