<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_body"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_surface"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingEnd="14dp"
  android:paddingBottom="12dp"
  android:paddingTop="14dp">

  <!-- The direction switch lives outside the list so it stays pinned and is
       never overlapped by list scroll effects. -->
  <LinearLayout
    android:id="@+id/toggle_row_h"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/widget_chip_idle"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:padding="2dp">

    <LinearLayout
      android:id="@+id/direction_route_h"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_direction_active_380"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:orientation="horizontal"
      android:paddingHorizontal="4dp">

      <TextView
        android:id="@+id/direction_origin_h"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Tbilisi"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginHorizontal="2dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_direction_arrow" />

      <TextView
        android:id="@+id/direction_destination_h"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Kojori"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <ImageView
      android:id="@+id/direction_swap_h"
      android:layout_width="32dp"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:importantForAccessibility="no"
      android:padding="7dp"
      android:src="@drawable/widget_ic_swap" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/toggle_row_v"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/widget_chip_idle"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:padding="2dp"
    android:visibility="gone">

    <LinearLayout
      android:id="@+id/direction_route_v"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_direction_active_380"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:orientation="horizontal"
      android:paddingHorizontal="8dp">

      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="3dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_direction_arrow" />

      <TextView
        android:id="@+id/direction_destination_v"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Kojori"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>

    <ImageView
      android:id="@+id/direction_swap_v"
      android:layout_width="30dp"
      android:layout_height="match_parent"
      android:contentDescription="@null"
      android:importantForAccessibility="no"
      android:padding="7dp"
      android:src="@drawable/widget_ic_swap" />
  </LinearLayout>

  <TextView
    android:id="@+id/widget_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="No widget snapshot yet"
    android:textColor="@color/widget_text_dim"
    android:textSize="12sp"
    android:visibility="gone" />

  <ListView
    android:id="@+id/widget_list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:divider="@null"
    android:dividerHeight="0dp"
    android:requiresFadingEdge="none"
    android:fadingEdgeLength="0dp"
    android:overScrollMode="never"
    android:scrollbars="none" />

</LinearLayout>
